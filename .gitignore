# Godot 4
.godot/
.import/
/android/

# The gs-* addons and zee-gs-weapons are separate repositories and are linked in, never
# committed. bootstrap.sh derives this project's dependencies from the lines below.
/addons/gs_core
/addons/gs_profile
/addons/gs_combat
/addons/gs_weapon
/addons/gs_net
/addons/gs_player
/addons/gs_player_controller
/addons/gs_player_char
/addons/gs_physics
/addons/zee_weapons

# zee-gs-weapons' own art, linked in so the range and the rack can draw zee's arms and
# weapons beside this pack's. Never committed: it is zee's.
/assets/arms
/assets/blaster-kit
/assets/melee

# Exports
build/
export.cfg
export_presets.cfg
*.translation

# Screenshots are evidence for a review, not assets.
/screenshots/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
/.scratch/

# Baked maps, for looking at
/art-src/hq/out/maps/
/addons/gs_audio

# Linked addons (separate repositories, symlinked in for local development).
/addons/gs_bot
/addons/gs_bot_record
/addons/gs_sim
/addons/gs_sql
/addons/godot-sqlite
/addons/gs_game
/addons/gs_animation
/.gs-pack

